# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyd

# Virtual environments
.venv/
venv/
env/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Node.js
node_modules/
frontend/node_modules/
**/node_modules/
frontend/.vite/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Notebooks
.ipynb_checkpoints/

# Logs / temp
*.log
*.tmp
*old/

# IDEs / editors
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local secrets / configs
.deploy.env
.env.local
.env.*.local

# Local upload marker
.upload

# Runtime artifacts: keep folders, ignore contents
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/runtime/*
!backend/runtime/.gitkeep
