# Python
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
env/
*.egg-info/
.eggs/

# JavaScript
node_modules/
.vite/

# Generated builds
build/
dist/

# Tests, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.ipynb_checkpoints/

# Browser automation
.playwright-mcp/
baseline-*.png

# Logs and temporary files
*.log
*.tmp
*old/

# Editors
.idea/
*.swp

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local configuration and tool state. Real values go in the ignored
# site/.env.local; only the blank site/.env.example template is committed.
.env
.env.local
.env.*.local
.deploy.env
!.env.example
!**/.env.example
.upload
.remember/

# Runtime artifacts: keep folders, ignore contents
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
site/backend/uploads/*
!site/backend/uploads/.gitkeep
site/backend/outputs/*
!site/backend/outputs/.gitkeep
site/backend/runtime/*
!site/backend/runtime/.gitkeep
