{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Web Preview",
      "type": "process",
      "command": "node",
      "args": [
        "deploy/preview.mjs",
        "--web"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LOCAL_DOMAIN": "localhost",
          "WEB_PORT": "8000"
        }
      },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Dev Mode",
      "type": "process",
      "command": "node",
      "args": [
        "deploy/preview.mjs",
        "--dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "5173",
          "LOCAL_DOMAIN": "localhost",
          "BACKEND_PORT": "8000"
        }
      },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
