#!/usr/bin/env bash
set -euo pipefail

# Prevent recursive deploys if deploy script runs git commands.
if [[ "${DEPLOY_HOOK_RUNNING:-0}" == "1" ]]; then
  exit 0
fi
export DEPLOY_HOOK_RUNNING=1

REPO_ROOT="$(git rev-parse --show-toplevel)"
DEPLOY_SCRIPT="${REPO_ROOT}/deploy/raspi-deploy.sh"
LOG_FILE="${REPO_ROOT}/deploy-hook.log"

if [[ ! -f "${DEPLOY_SCRIPT}" ]]; then
  echo "[$(date -Is)] post-merge: deploy script not found at ${DEPLOY_SCRIPT}" >> "${LOG_FILE}"
  exit 1
fi

{
  echo "[$(date -Is)] post-merge: starting deploy"
  bash "${DEPLOY_SCRIPT}"
  echo "[$(date -Is)] post-merge: deploy finished"
} >> "${LOG_FILE}" 2>&1
