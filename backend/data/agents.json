{
  "_config": {
    "metadataKeys": [
      "agent_key",
      "agent_name",
      "workflow_id",
      "model",
      "reasoning_level",
      "execution_time_seconds",
      "received_from_node",
      "sent_to_node",
      "agent_received_from",
      "agent_sent_to",
      "input_summary",
      "questions_count",
      "filename",
      "pdf_filename",
      "status",
      "started_at",
      "ended_at",
      "reused_from_output_folder",
      "output_folder",
      "files",
      "input_metadata",
      "output_metadata"
    ],
    "wrappedRecordMarkerKeys": ["recorded_at", "agent_key", "attempt"],
    "validThemes": ["life_science", "engineering", "everyday_activity", "physics_abstract"],
    "apiTitle": "Isomorphic Question Generator API",
    "apiDescription": "Generate isomorphic physics questions using AI agents"
  },
  "setup": {
    "sequence": 0,
    "name": "Starter",
    "description": "Prepares the shared workflow runtime",
    "model": "OpenAI Runtime",
    "bootstrapModel": "gpt-5.5",
    "reasoning": "none",
    "kind": "runtime",
    "isLLM": false,
    "hasPrompt": false,
    "acceptsSourceFiles": false,
    "isStoppable": false,
    "useCodeInterpreter": false,
    "countLabel": null,
    "aliases": [],
    "inputFrom": "User",
    "outputTo": "Normalizer",
    "cliDescription": "Bootstrap the shared container and upload source files",
    "allowedDomains": [
      "archive.ubuntu.com",
      "security.ubuntu.com",
      "deb.debian.org",
      "security.debian.org",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "containerPythonPackages": [
      "pymupdf",
      "pdf2image",
      "pdfplumber",
      "PyPDF2",
      "python-docx"
    ]
  },
  "normalizer": {
    "sequence": 1,
    "name": "Normalizer",
    "description": "Parses user request into configuration",
    "model": "gpt-5.5",
    "reasoning": "none",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "acceptsSourceFiles": true,
    "isStoppable": true,
    "useCodeInterpreter": false,
    "countLabel": null,
    "aliases": [],
    "inputFrom": "User",
    "outputTo": "Extracter",
    "cliDescription": "Parse user instructions into generation config (new_questions_per_question, difficulty, theme)",
    "resultField": "config"
  },
  "extracter": {
    "sequence": 2,
    "name": "Extracter",
    "description": "Reads files and extracts questions",
    "model": "gpt-5.5",
    "reasoning": "none",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "acceptsSourceFiles": true,
    "isStoppable": true,
    "useCodeInterpreter": true,
    "countLabel": "Extracted",
    "aliases": ["extractor"],
    "inputFrom": "Normalizer",
    "outputTo": "Verifier",
    "cliDescription": "Extract source questions from uploaded PDF/DOCX files",
    "resultField": "source_questions"
  },
  "verifier": {
    "sequence": 3,
    "name": "Verifier",
    "description": "Validates answers and adds explanations",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "acceptsSourceFiles": false,
    "isStoppable": true,
    "useCodeInterpreter": true,
    "countLabel": "Verified",
    "aliases": [],
    "inputFrom": "Extracter",
    "outputTo": "Generator",
    "cliDescription": "Validate extracted questions; fill answers/explanations; label distractor logic",
    "resultField": "verified_questions"
  },
  "generator": {
    "sequence": 4,
    "name": "Generator",
    "description": "Creates isomorphic questions",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "acceptsSourceFiles": false,
    "isStoppable": true,
    "useCodeInterpreter": true,
    "countLabel": "Generated",
    "aliases": [],
    "inputFrom": "Verifier",
    "outputTo": "Latexifier",
    "cliDescription": "Generate isomorphic questions; run style review; validate contract",
    "resultField": "generated_questions"
  },
  "latexifier": {
    "sequence": 5,
    "name": "Latexifier",
    "description": "Converts questions to LaTeX format",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "acceptsSourceFiles": false,
    "isStoppable": true,
    "useCodeInterpreter": false,
    "countLabel": null,
    "aliases": ["latex", "latex_formatter", "latexformatter"],
    "inputFrom": "Generator",
    "outputTo": "Evaluator",
    "cliDescription": "Format questions to LaTeX; compile PDF",
    "resultField": "latex_file"
  },
  "evaluation": {
    "sequence": 6,
    "name": "Evaluator",
    "description": "Scores generated outputs and writes evaluator artifacts",
    "model": "gpt-5.5",
    "reasoning": "low",
    "kind": "agent",
    "isLLM": true,
    "hasPrompt": true,
    "promptName": "evaluator",
    "acceptsSourceFiles": false,
    "isStoppable": false,
    "useCodeInterpreter": false,
    "countLabel": null,
    "aliases": ["eval"],
    "inputFrom": "Latexifier",
    "outputTo": "Output",
    "cliDescription": "Run 9-criterion evaluation rubric on generated output (OpenAI Evals)"
  },
  "output": {
    "sequence": 7,
    "name": "Output",
    "description": "Finalizes workflow files and result metadata",
    "model": "Workflow Runtime",
    "reasoning": "none",
    "kind": "runtime",
    "isLLM": false,
    "hasPrompt": false,
    "acceptsSourceFiles": false,
    "isStoppable": false,
    "useCodeInterpreter": false,
    "countLabel": null,
    "aliases": [],
    "inputFrom": "Evaluator",
    "outputTo": "User",
    "cliDescription": "Finalize workflow files and write final_result.json"
  }
}
