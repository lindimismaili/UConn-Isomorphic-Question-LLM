{
  "normalizer": {
    "name": "Normalizer",
    "description": "Parses user request into configuration",
    "model": "gpt-5.5",
    "reasoning": "none",
    "inputFrom": "User",
    "outputTo": "Extracter",
    "useCodeInterpreter": false
  },
  "extracter": {
    "name": "Extracter",
    "description": "Reads files and extracts questions",
    "model": "gpt-5.5",
    "reasoning": "none",
    "inputFrom": "Normalizer",
    "outputTo": "Verifier",
    "useCodeInterpreter": true
  },
  "verifier": {
    "name": "Verifier",
    "description": "Validates answers and adds explanations",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "inputFrom": "Extracter",
    "outputTo": "Generator",
    "useCodeInterpreter": true
  },
  "generator": {
    "name": "Generator",
    "description": "Creates isomorphic questions",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "inputFrom": "Verifier",
    "outputTo": "Latexifier",
    "useCodeInterpreter": true
  },
  "latexifier": {
    "name": "Latexifier",
    "description": "Converts questions to LaTeX format",
    "model": "gpt-5.5",
    "reasoning": "medium",
    "inputFrom": "Generator",
    "outputTo": "Evaluator",
    "useCodeInterpreter": false
  }
}
