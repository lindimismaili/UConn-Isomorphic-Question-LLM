# Runtime configuration reference. Keep real values in an ignored local file.
#
# Precedence, highest first:
#   1. process environment (the Pi service uses `/etc/uconn-isomorphic/environment`);
#   2. ignored, machine-local `site/.env.local`;
#   3. optional ignored `site/.env`.
#
# Put personal credentials in `.env.local` for local development or in the
# external Pi environment file. Never commit real keys or access tokens.

# --- OpenAI credential (required for workflows, not for server startup) ---
# Leave this blank in examples. The authenticated `/api/readiness` endpoint
# reports only whether a key is configured; it never returns the value.
OPENAI_API_KEY=

# --- Access boundary and donation link ---
# Required for every shared, LAN, tunnel, or public deployment.
# When unset, protected API routes remain open for backwards-compatible local
# use. The browser sends this opaque value as `X-App-Access-Token` and keeps it
# only in sessionStorage. Generate a long random value; do not reuse an API key.
# APP_ACCESS_TOKEN=
# Manual values must be 32-512 characters from: A-Z a-z 0-9 . _ ~ + / = -
# `deploy/preview.{mjs,sh} --dev --lan` refuses an unprotected LAN session:
# it preserves a configured token or creates a process-only token and prints it
# once for the browser Access Gate. A manual non-loopback Uvicorn bind has no
# such fallback and requires APP_ACCESS_TOKEN before startup.

# In-process, per-ASGI-client sliding-window limit for cost-bearing POST routes.
# A reverse proxy can make several users share one client address. Counters
# reset when the server restarts. Invalid/non-positive values use these defaults.
# APP_RATE_LIMIT_REQUESTS=12
# APP_RATE_LIMIT_WINDOW_SECONDS=60

# Optional public donation link. Only HTTPS URLs hosted by paypal.com or
# paypal.me (standard port 443, no embedded credentials) are exposed to the UI.
# Do not put PayPal REST credentials or secrets in browser-facing configuration.
# PAYPAL_DONATE_URL=https://www.paypal.com/donate/?hosted_button_id=YOUR_BUTTON_ID

# --- Server / CORS ---
# Comma-separated exact-origin allowlist for CORS and unsafe API requests that
# carry a browser Origin header. The default permits only localhost and
# 127.0.0.1 on ports 8000 and 5173.
# ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# The preview launchers build a process-only allowlist containing those
# loopback origins. With `--lan`, they also detect, print, and authorize only
# the exact LAN origin. If automatic detection fails, set PREVIEW_LAN_HOST in
# the launcher command environment (not in this backend dotenv file).
# Direct `python -m backend.src.server` launch defaults to loopback. Set an
# explicit interface only when a reverse proxy or trusted LAN requires it.
# HOST=127.0.0.1
# PORT=8000

# --- Upload and artifact retention ---
# Core upload/retention limits below are fail-closed; each later setting states
# whether it is strict, clamped, or falls back to a default. Do not assume one
# validation policy for every optional experiment toggle.
# Byte limits: one uploaded file, then all files in one `/api/upload` request.
# 20 MiB per file:
# MAX_UPLOAD_BYTES=20971520
# 60 MiB per request:
# MAX_UPLOAD_TOTAL_BYTES=62914560

# Upload sessions are pruned by age and total disk use. This capacity is also
# enforced live across concurrent upload requests; a request receives HTTP 507
# before its session would cross the limit.
# 24 hours:
# UPLOAD_RETENTION_SECONDS=86400
# 2 GiB:
# UPLOAD_MAX_BYTES=2147483648

# Completed output runs are pruned by age, count, and total disk use.
# 7 days:
# OUTPUT_RETENTION_SECONDS=604800
# OUTPUT_MAX_RUNS=500
# 20 GiB:
# OUTPUT_MAX_BYTES=21474836480

# Cleanup cadence: artifact cleanup is strict (60-86400 seconds); the general
# prune loop is strict (5-86400 seconds).
# ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
# PRUNE_INTERVAL_SECONDS=60

# --- Workflow lifecycle, admission, and concurrency ---
# Retain terminal workflow/batch records for 24 hours, with at most 200
# in-memory entries per registry. A non-terminal record without a live task is
# marked lost after ACTIVE_WORKFLOW_STALE_SECONDS.
# WORKFLOW_TTL_SECONDS=86400
# WORKFLOW_MAX_ENTRIES=200
# ACTIVE_WORKFLOW_STALE_SECONDS=21600

# Full agentic workflows share this process-wide paid-execution cap. Keep 1 on
# a Raspberry Pi unless load testing demonstrates safe higher concurrency.
# OPENAI_WORKFLOW_CONCURRENCY=1

# Shared admission cap across direct workflows and every reserved Create Data
# child. New starts fail before paid work when the pool is full.
# MAX_ACTIVE_WORKFLOWS=4

# Every paid HTTP/CLI instruction is capped at 20,000 characters before
# provider work, idempotency hashing, or persistence. This safety boundary is
# intentionally fixed and has no environment override.

# The web app uses status polling and does not consume token deltas. Leave
# this false to avoid per-run streaming and queue overhead. Enable only for a
# custom client that consumes `/api/workflow/{id}/stream` token events.
# WORKFLOW_TOKEN_STREAMING_ENABLED=false

# Bounds blocking SDK/filesystem calls dispatched to worker threads.
# OPENAI_WORKFLOW_BLOCKING_CONCURRENCY=4

# Every provider-backed operation fails closed after a finite wall-clock
# deadline. Agent-stage and guardrail deadlines cancel their async SDK task;
# container shell calls also receive an SDK transport timeout and the local
# LaTeX tool fails the run instead of returning a model-visible timeout.
# Bounds: agent 30-3600, one guardrail request 10-600, one complete
# input/content classifier phase 10-1800, classifier calls 1-16, container
# 30-1800, eval 60-3600.
# OPENAI_AGENT_STAGE_TIMEOUT_SECONDS=900
# OPENAI_GUARDRAIL_TIMEOUT_SECONDS=120
# OPENAI_GUARDRAIL_STAGE_TIMEOUT_SECONDS=300
# OPENAI_GUARDRAIL_MAX_CLASSIFIER_REQUESTS=16
# OPENAI_CONTAINER_TASK_TIMEOUT_SECONDS=600
# OPENAI_EVALUATION_TIMEOUT_SECONDS=900
# Every explicitly constructed sync SDK client also has a finite transport
# timeout. Automatic retries default off to avoid duplicate paid calls or
# orphaned resource creation; only raise deliberately after reviewing cost.
# Bounds: request timeout 10-600 seconds, retries 0-2.
# OPENAI_PROVIDER_REQUEST_TIMEOUT_SECONDS=120
# OPENAI_PROVIDER_MAX_RETRIES=0

# Per-batch fan-out. Full workflows are still governed by
# OPENAI_WORKFLOW_CONCURRENCY; eval-only entries use this batch cap directly.
# BATCH_WORKFLOW_CONCURRENCY=2

# --- Guardrails and tracing privacy ---
# The registry default is enabled and fail-closed. Accepted overrides are
# 1/0, true/false, yes/no, or on/off. Structural size/complexity bounds remain
# active even when semantic/model checks are disabled. Do not disable this on
# shared deployments.
# GUARDRAILS_ENABLED=true

# Agent SDK tracing is privacy-sensitive because inputs can contain uploaded
# course material. Main workflow/guardrail calls default to disabled; setting 1
# also enforces the SDK-wide opt-out for auxiliary paths. Keep 1 on shared
# deployments; use 0 only for an intentional, sanitized debugging session.
# OPENAI_AGENTS_DISABLE_TRACING=1

# --- OpenAI container and status checks ---
# Container bootstrap model/packages come from `backend/data/agents.json`;
# there is no environment override for the bootstrap model.
# Clamped to 1-20:
# OPENAI_CONTAINER_EXPIRES_MINUTES=20
# OpenAI also requires an organization administrator to allow these same
# domains in the API Platform dashboard. The request policy below may narrow
# that organization list but cannot expand it. Keep both layers least-privilege.
# OPENAI_CONTAINER_ALLOWED_DOMAINS=archive.ubuntu.com,security.ubuntu.com,deb.debian.org,security.debian.org,pypi.org,files.pythonhosted.org
# Each provider-generated PDF or TeX download streams to disk and is rejected
# above this size. Default 50 MiB; strict range 1 byte through 512 MiB.
# MAX_GENERATED_ARTIFACT_BYTES=52428800
# Provider file objects are deleted immediately after a run when possible and
# also expire automatically after this many seconds if the process crashes
# first. OpenAI accepts 3600-2592000 seconds; the default is one day.
# OPENAI_FILE_EXPIRES_SECONDS=86400
# Public provider-status responses (including failures) are single-flight
# cached for 5-300 seconds so monitoring cannot amplify outbound requests.
# OPENAI_STATUS_CACHE_SECONDS=60
# OPENAI_STATUS_TIMEOUT_SECONDS=5

# --- Optional cost/experiment controls ---
# Hard per-run item limits are checked before downstream paid stages. Defaults
# support ordinary assignments while bounding denial-of-wallet amplification;
# accepted maxima are 200 source, 500 generated, and 500 evaluated questions.
# MAX_SOURCE_QUESTIONS=25
# MAX_GENERATED_QUESTIONS=100
# MAX_EVALUATION_ITEMS=100
# One batch may evaluate at most five prior runs, or one source PDF plus five
# generated PDFs, and at most 100 total questions. Only one Create Data or eval
# batch is admitted at a time by default.
# MAX_EVAL_BATCH_ENTRIES=5
# MAX_EVAL_BATCH_ITEMS=100
# MAX_CREATE_DATA_ENTRIES=5
# MAX_ACTIVE_BATCH_JOBS=1
# Refuse on-demand ZIP creation when a run's uncompressed artifacts exceed
# this many bytes (default 128 MiB, hard maximum 512 MiB). The browser download
# path buffers the resulting ZIP blob, so raise only for a deliberate,
# well-resourced client.
# DOWNLOAD_ZIP_MAX_SOURCE_BYTES=134217728

# holistic (default) or decompose. Unknown values fall back to holistic.
# GENERATION_STRATEGY=holistic

# The generator prompt already requires self-review. A second full high-reasoning
# wording pass is disabled by default because it approximately doubles generator
# calls; enable only for an intentional quality experiment.
# GENERATOR_STYLE_REVIEW_ENABLED=false

# Optional cross-family judge model; unset uses the evaluation model in
# `backend/data/agents.json`. Model choice directly affects evaluation cost.
# GRADER_MODEL_OVERRIDE=
# Every one of the eight score-model calls per evaluated question has this
# generated-token ceiling. Default 4096; strict range 256-16384.
# GRADER_MAX_COMPLETION_TOKENS=4096

# Exact-input stage cache. Off by default. Enabling can reduce repeat calls but
# persists exact stage outputs in `backend/runtime/stage_cache.sqlite3`.
# ENABLE_STAGE_CACHE=false
# Retention is bounded even when enabled: 24 hours, 128 entries, and 2 MiB per
# serialized record by default. Hard ceilings are 30 days, 1000 entries, and
# 16 MiB; invalid values fall back to the safe defaults.
# STAGE_CACHE_TTL_SECONDS=86400
# STAGE_CACHE_MAX_ENTRIES=128
# STAGE_CACHE_MAX_RECORD_BYTES=2097152
