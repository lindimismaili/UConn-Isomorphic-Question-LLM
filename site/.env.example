# Baseline environment reference. This repository deliberately tracks `site/.env`;
# keep real production-only overrides in the Pi runtime configuration instead.
# Only OPENAI_API_KEY is required; other values are optional or have in-code defaults.

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Server / CORS ---
# Comma-separated allowlist. Defaults to localhost:8000 and Vite localhost:5173.
# ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# HOST=127.0.0.1
# PORT=8000

# --- Upload / output limits ---
# MAX_UPLOAD_BYTES=20971520            # 20 MiB per uploaded file
# UPLOAD_RETENTION_SECONDS=86400       # 24h before upload sessions are pruned
# UPLOAD_MAX_BYTES=2147483648          # 2 GiB total uploads on disk
# OUTPUT_RETENTION_SECONDS=604800      # 7d before output runs are pruned
# OUTPUT_MAX_RUNS=500
# OUTPUT_MAX_BYTES=21474836480         # 20 GiB total outputs on disk
# ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600

# --- Workflow lifecycle ---
# WORKFLOW_TTL_SECONDS=86400
# WORKFLOW_MAX_ENTRIES=200
# ACTIVE_WORKFLOW_STALE_SECONDS=21600
# OPENAI_WORKFLOW_BLOCKING_CONCURRENCY=4
# BATCH_WORKFLOW_CONCURRENCY=2

# --- OpenAI container runtime ---
# OPENAI_CONTAINER_BOOTSTRAP_MODEL=gpt-5.5
# OPENAI_CONTAINER_EXPIRES_MINUTES=20  # clamped to 1-20
# OPENAI_CONTAINER_ALLOWED_DOMAINS=archive.ubuntu.com,pypi.org,files.pythonhosted.org
# OPENAI_STATUS_TIMEOUT_SECONDS=5

# --- Optional workflow behavior ---
# ENABLE_STAGE_CACHE=false
# GENERATION_STRATEGY=holistic
# GUARDRAILS_ENABLED=true
# GRADER_MODEL_OVERRIDE=

# --- Operations dashboard / local testing ---
# The tracked local default enables the dashboard only from a direct loopback
# connection. The Pi systemd unit always overrides ADMIN_LOCAL_DEV_MODE=false.
# ADMIN_LOCAL_DEV_MODE=true
# ADMIN_LOCAL_DEV_EMAIL=local-admin@example.test
# ADMIN_MAX_ZIP_BYTES=5368709120
# ADMIN_MAX_ZIP_FILES=10000

# --- Pi-only Cloudflare Access and alerts ---
# Set these in /var/lib/uconn-isomorphic/config/admin-runtime.env, never in a
# browser bundle. Cloudflare Access must also be configured separately in Zero Trust.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience
# ADMIN_EMAILS=owner@example.com,second.admin@example.com
# OPENAI_ADMIN_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# ALERT_RECIPIENTS=owner@example.com
# RUNTIME_CONFIG_PATH=/var/lib/uconn-isomorphic/config/admin-runtime.env
# OPERATIONS_MONITOR_SECONDS=60
