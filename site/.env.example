# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only OPENAI_API_KEY is required; everything else has a safe in-code default.

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Server / CORS ---
# Comma-separated allowlist. Defaults to localhost:8000 and Vite localhost:5173.
# ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# HOST=127.0.0.1
# PORT=8000

# --- Upload / output limits ---
# MAX_UPLOAD_BYTES=20971520            # 20 MiB per uploaded file
# UPLOAD_RETENTION_SECONDS=86400       # 24h before upload sessions are pruned
# UPLOAD_MAX_BYTES=2147483648          # 2 GiB total uploads on disk
# OUTPUT_RETENTION_SECONDS=604800      # 7d before output runs are pruned
# OUTPUT_MAX_RUNS=500
# OUTPUT_MAX_BYTES=21474836480         # 20 GiB total outputs on disk
# ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600

# --- Workflow lifecycle ---
# WORKFLOW_TTL_SECONDS=86400
# WORKFLOW_MAX_ENTRIES=200
# ACTIVE_WORKFLOW_STALE_SECONDS=21600
# OPENAI_WORKFLOW_BLOCKING_CONCURRENCY=4
# BATCH_WORKFLOW_CONCURRENCY=2

# --- OpenAI container runtime ---
# OPENAI_CONTAINER_BOOTSTRAP_MODEL=gpt-5.5
# OPENAI_CONTAINER_EXPIRES_MINUTES=20  # clamped to 1-20
# OPENAI_CONTAINER_ALLOWED_DOMAINS=archive.ubuntu.com,pypi.org,files.pythonhosted.org
# OPENAI_STATUS_TIMEOUT_SECONDS=5
