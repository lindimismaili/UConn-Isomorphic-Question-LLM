[Unit]
Description=UConn Isomorphic Question LLM (FastAPI)
After=network.target

[Service]
Type=simple

User=www-data
Group=www-data

WorkingDirectory=/var/www/uconn

Environment=HOST=127.0.0.1
Environment=PORT=3002
EnvironmentFile=/var/www/uconn/.env

ExecStart=/var/www/uconn/.venv/bin/uvicorn src.server:app --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=3

# Optional: log to journald with a stable identifier
SyslogIdentifier=uconn

# Basic hardening (generally safe for FastAPI apps)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
